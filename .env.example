POSTGRES_DB=bioacervo
POSTGRES_USER=bioacervo
POSTGRES_PASSWORD=bioacervo_dev_password

DATABASE_URL=postgresql+asyncpg://bioacervo:bioacervo_dev_password@database:5432/bioacervo
DATABASE_URL_SYNC=postgresql+psycopg2://bioacervo:bioacervo_dev_password@database:5432/bioacervo

SECRET_KEY=change-this-development-secret-before-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480
ENVIRONMENT=development
CORS_ORIGINS=http://localhost,http://localhost:8080,http://127.0.0.1:8080

UPLOAD_DIR=/bucket/images
MAX_IMAGE_SIZE_MB=20
MAX_IMAGE_PIXELS=50000000
ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/tiff,image/webp
EXPORT_DIR=/bucket/exports

ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-this-admin-password
CREATE_TABLES_ON_SEED=False

APP_HOST=0.0.0.0
APP_PORT=8000
DEBUG=False

BACKEND_PORT=8000
FRONTEND_PORT=8080
APP_UID=1000
APP_GID=1000
